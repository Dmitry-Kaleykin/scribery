{
  "name": "scribery",
  "version": "0.1.0",
  "description": "CLI, MCP server, and compatibility facade for Scribery",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "scribery": "./dist/cli.js",
    "scribery-mcp": "./dist/mcp.js"
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc --project tsconfig.build.json && node ../../scripts/mark-binaries-executable.mjs dist/cli.js dist/mcp.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "scribery-code": "0.1.0",
    "scribery-core": "0.1.0",
    "scribery-documents": "0.1.0",
    "zod": "^4.4.3"
  },
  "engines": { "node": ">=22.19.0" }
}

