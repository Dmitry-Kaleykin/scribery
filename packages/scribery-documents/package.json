{
  "name": "scribery-documents",
  "version": "0.1.0",
  "description": "Managed document collections and directory sources for Scribery",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
