    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": { "scribery-core": "0.1.0" },
  "engines": { "node": ">=22.19.0" }
}

